[Unit]
Description=Autonomous CSI collector for an independent device
After=local-fs.target
RequiresMountsFor=/var/lib/cws-collector-device

[Service]
Type=simple
User=cws-collector
Group=cws-collector
SupplementaryGroups=dialout
UMask=0027
ExecStart=/opt/cws-collector/venv/bin/cws-collector --state-dir /var/lib/cws-collector-device service
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cws-collector-device

[Install]
WantedBy=multi-user.target
